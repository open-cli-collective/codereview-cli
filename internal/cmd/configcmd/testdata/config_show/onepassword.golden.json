{
  "active_profile": "fixture",
  "profile": {
    "repository_access": "fixture-git",
    "reviewer": {
      "kind": "git_identity"
    },
    "llm_runtime": "fixture-llm",
    "review_policy": {
      "major_event": "request_changes",
      "allow_self_approve": false,
      "resolve_threads": "auto"
    }
  },
  "data": {
    "retention": {
      "max_age_days": 90,
      "enforcement": "at_write"
    }
  },
  "backend": "op-desktop",
  "backend_source": "credential_store",
  "active_secrets_profile": {
    "id": "desktop",
    "label": "Desktop 1Password",
    "backend": "op-desktop",
    "source": "configured"
  },
  "secrets_profiles": [
    {
      "id": "local-os",
      "display_name": "OS credential store",
      "backend": "auto",
      "read_only": true,
      "source": "built_in",
      "label": "OS credential store"
    },
    {
      "id": "desktop",
      "display_name": "Desktop 1Password",
      "backend": "op-desktop",
      "source": "configured",
      "label": "Desktop 1Password"
    }
  ],
  "credential_ref": "codereview/fixture",
  "credential_refs": [
    {
      "purpose": "git",
      "ref": "codereview/fixture",
      "mode": "pat",
      "keys": [
        {
          "key": "git_token",
          "required": true,
          "present": false,
          "status": "missing"
        }
      ]
    }
  ],
  "llm_credential": {
    "mode": "adapter_managed"
  }
}
